<!--
  ig26-authorize-agent: the domain boundary.

  Callers set the variable "ig26-required-role" before including this fragment.
  1. Validate the Entra token: issued by this tenant, audience = the governed MCP gateway app.
  2. Read the caller (azp for v2 tokens, appid for v1), its app roles, and the agent
     claims: xms_act_fct (actor facets; 11 = AgentIdentity) and xms_par_app_azp (the
     parent application, logged for audit, never used for authorization).
  3. Agent marker check, controlled by the named value ig26-agent-token-check:
     "audit" (default) traces tokens without an agent marker, "enforce" rejects them
     with 403, "off" skips the check. The marker is xms_act_fct containing 11, or
     xms_par_app_azp being present.
  4. Authorize on the roles claim only: allow callers that hold the domain's app role.
     App roles are granted as app role assignments on the gateway app, so access is
     visible, reviewable and revocable in Entra, and Conditional Access applies
     because the gateway is an Entra resource with a service principal.
  On deny: 403 with a reason, a trace record and a custom metric, before any backend
  or model sees the request.

  Docs: https://learn.microsoft.com/azure/api-management/validate-azure-ad-token-policy
        https://learn.microsoft.com/azure/api-management/secure-mcp-servers
        https://learn.microsoft.com/entra/agent-id/agent-token-claims
-->
<fragment>
	<validate-azure-ad-token tenant-id="{{ig26-tenant-id}}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized: a Microsoft Entra token for the governed MCP gateway is required." output-token-variable-name="ig26-jwt">
		<audiences>
			<audience>{{ig26-mcp-gateway-app-id}}</audience>
			<audience>api://{{ig26-mcp-gateway-app-id}}</audience>
		</audiences>
	</validate-azure-ad-token>
	<set-variable name="ig26-caller" value="@{
		var jwt = (Jwt)context.Variables["ig26-jwt"];
		return jwt.Claims.GetValueOrDefault("azp", jwt.Claims.GetValueOrDefault("appid", "unknown"));
	}" />
	<set-variable name="ig26-caller-roles" value="@{
		var jwt = (Jwt)context.Variables["ig26-jwt"];
		return jwt.Claims.ContainsKey("roles") ? string.Join(",", jwt.Claims["roles"]) : "";
	}" />
	<set-variable name="ig26-parent-app" value="@{
		var jwt = (Jwt)context.Variables["ig26-jwt"];
		return jwt.Claims.GetValueOrDefault("xms_par_app_azp", "");
	}" />
	<set-variable name="ig26-agent-marker" value="@{
		var jwt = (Jwt)context.Variables["ig26-jwt"];
		var facets = jwt.Claims.GetValueOrDefault("xms_act_fct", "");
		var parent = jwt.Claims.GetValueOrDefault("xms_par_app_azp", "");
		return (facets.Split(' ').Contains("11") || !string.IsNullOrEmpty(parent)) ? "present" : "missing";
	}" />
	<choose>
		<when condition="@("{{ig26-agent-token-check}}" == "enforce" &amp;&amp; (string)context.Variables["ig26-agent-marker"] == "missing")">
			<trace source="ig26-domain-boundary" severity="error">
				<message>@("DENY caller=" + (string)context.Variables["ig26-caller"] + " api=" + context.Api.Name + " reason=agent-marker-missing")</message>
				<metadata name="ig26.decision" value="deny" />
				<metadata name="ig26.caller" value="@((string)context.Variables["ig26-caller"])" />
				<metadata name="ig26.api" value="@(context.Api.Name)" />
				<metadata name="ig26.reason" value="agent-marker-missing" />
			</trace>
			<emit-metric name="ig26-boundary-deny" namespace="ig26">
				<dimension name="Caller" value="@((string)context.Variables["ig26-caller"])" />
				<dimension name="API ID" />
			</emit-metric>
			<return-response>
				<set-status code="403" reason="Forbidden" />
				<set-header name="Content-Type" exists-action="override">
					<value>application/json</value>
				</set-header>
				<set-header name="x-ig26-deny-reason" exists-action="override">
					<value>agent-marker</value>
				</set-header>
				<set-body>@(new JObject(
					new JProperty("error", "forbidden"),
					new JProperty("reason", "This gateway only accepts agent identity tokens. The token carries no agent marker (xms_act_fct 11 or xms_par_app_azp)."),
					new JProperty("caller", (string)context.Variables["ig26-caller"]),
					new JProperty("requestId", context.RequestId.ToString())
				).ToString())</set-body>
			</return-response>
		</when>
		<when condition="@("{{ig26-agent-token-check}}" == "audit" &amp;&amp; (string)context.Variables["ig26-agent-marker"] == "missing")">
			<trace source="ig26-domain-boundary" severity="information">
				<message>@("AUDIT caller=" + (string)context.Variables["ig26-caller"] + " api=" + context.Api.Name + " agent marker missing (named value ig26-agent-token-check is audit)")</message>
				<metadata name="ig26.decision" value="audit" />
				<metadata name="ig26.caller" value="@((string)context.Variables["ig26-caller"])" />
				<metadata name="ig26.reason" value="agent-marker-missing" />
			</trace>
		</when>
	</choose>
	<choose>
		<when condition="@(!((string)context.Variables["ig26-caller-roles"]).Split(',').Contains((string)context.Variables["ig26-required-role"]))">
			<trace source="ig26-domain-boundary" severity="error">
				<message>@("DENY caller=" + (string)context.Variables["ig26-caller"] + " api=" + context.Api.Name + " required_role=" + (string)context.Variables["ig26-required-role"])</message>
				<metadata name="ig26.decision" value="deny" />
				<metadata name="ig26.caller" value="@((string)context.Variables["ig26-caller"])" />
				<metadata name="ig26.parent_app" value="@((string)context.Variables["ig26-parent-app"])" />
				<metadata name="ig26.api" value="@(context.Api.Name)" />
				<metadata name="ig26.required_role" value="@((string)context.Variables["ig26-required-role"])" />
			</trace>
			<emit-metric name="ig26-boundary-deny" namespace="ig26">
				<dimension name="Caller" value="@((string)context.Variables["ig26-caller"])" />
				<dimension name="API ID" />
			</emit-metric>
			<choose>
				<!-- MCP server scope sets ig26-deny-style=jsonrpc: MCP clients need tool
				     failures as a JSON-RPC isError result (HTTP 200), or the whole agent
				     run fails instead of showing a denied tool call. The deny is still
				     traced and metered above; the REST scope keeps the hard 403 below. -->
				<when condition="@(context.Variables.ContainsKey("ig26-deny-style") &amp;&amp; (string)context.Variables["ig26-deny-style"] == "jsonrpc")">
					<return-response>
						<set-status code="200" reason="OK" />
						<set-header name="Content-Type" exists-action="override">
							<value>application/json</value>
						</set-header>
						<set-header name="x-ig26-deny-reason" exists-action="override">
							<value>domain-boundary</value>
						</set-header>
						<set-body>@{
							var deny = new JObject(
								new JProperty("error", "forbidden"),
								new JProperty("httpEquivalent", 403),
								new JProperty("reason", "This agent's domain is not allowed to use this tool. Denied at the API Management AI gateway before reaching the backend."),
								new JProperty("caller", (string)context.Variables["ig26-caller"]),
								new JProperty("api", context.Api.Name),
								new JProperty("requiredRole", (string)context.Variables["ig26-required-role"]),
								new JProperty("requestId", context.RequestId.ToString())
							);
							object idRaw = context.Variables.GetValueOrDefault("ig26-mcp-id", "0");
							long idNum;
							var idValue = long.TryParse((string)idRaw, out idNum) ? new JValue(idNum) : new JValue((string)idRaw);
							return new JObject(
								new JProperty("jsonrpc", "2.0"),
								new JProperty("id", idValue),
								new JProperty("result", new JObject(
									new JProperty("isError", true),
									new JProperty("content", new JArray(new JObject(
										new JProperty("type", "text"),
										new JProperty("text", deny.ToString())
									)))
								))
							).ToString();
						}</set-body>
					</return-response>
				</when>
				<otherwise>
					<return-response>
						<set-status code="403" reason="Forbidden" />
						<set-header name="Content-Type" exists-action="override">
							<value>application/json</value>
						</set-header>
						<set-header name="x-ig26-deny-reason" exists-action="override">
							<value>domain-boundary</value>
						</set-header>
						<set-body>@(new JObject(
							new JProperty("error", "forbidden"),
							new JProperty("reason", "This agent's domain is not allowed to use this tool. Denied at the API Management AI gateway before reaching the backend."),
							new JProperty("caller", (string)context.Variables["ig26-caller"]),
							new JProperty("api", context.Api.Name),
							new JProperty("requiredRole", (string)context.Variables["ig26-required-role"]),
							new JProperty("requestId", context.RequestId.ToString())
						).ToString())</set-body>
					</return-response>
				</otherwise>
			</choose>
		</when>
	</choose>
	<trace source="ig26-domain-boundary" severity="information">
		<message>@("ALLOW caller=" + (string)context.Variables["ig26-caller"] + " api=" + context.Api.Name + " parent_app=" + (string)context.Variables["ig26-parent-app"])</message>
		<metadata name="ig26.decision" value="allow" />
		<metadata name="ig26.caller" value="@((string)context.Variables["ig26-caller"])" />
		<metadata name="ig26.parent_app" value="@((string)context.Variables["ig26-parent-app"])" />
	</trace>
</fragment>
