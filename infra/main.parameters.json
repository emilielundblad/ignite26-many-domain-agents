{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "mcpGatewayAppId": {
      "value": "${MCP_GATEWAY_APP_ID}"
    },
    "apimPublisherEmail": {
      "value": "${APIM_PUBLISHER_EMAIL=noreply@example.com}"
    },
    "modelName": {
      "value": "${MODEL_NAME=gpt-4.1-mini}"
    },
    "modelVersion": {
      "value": "${MODEL_VERSION=2025-04-14}"
    },
    "modelCapacity": {
      "value": "${MODEL_CAPACITY=50}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL=}"
    },
    "enableAppGateway": {
      "value": "${ENABLE_APP_GATEWAY=false}"
    },
    "appGatewayHostName": {
      "value": "${APP_GATEWAY_HOST_NAME=}"
    },
    "appGatewayCertificateUri": {
      "value": "${APP_GATEWAY_CERT_URI=}"
    },
    "ownerTag": {
      "value": "${OWNER_TAG=ig26-lab}"
    },
    "supportTokensPerMinute": {
      "value": "${SUPPORT_TOKENS_PER_MINUTE=4000}"
    },
    "docsTokensPerMinute": {
      "value": "${DOCS_TOKENS_PER_MINUTE=40000}"
    }
  }
}
