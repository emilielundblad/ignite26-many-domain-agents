{
  "openapi": "3.0.3",
  "info": {
    "title": "Credit-note API",
    "version": "1.0.0",
    "description": "Customer operations: draft credit notes. Restricted to the Customer ops domain. Fake data, no money moves."
  },
  "paths": {
    "/credit-notes": {
      "post": {
        "operationId": "create-credit-note",
        "summary": "Create a credit note",
        "description": "Creates a draft credit note for a customer. Restricted to Customer operations agents.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreditNoteIn" } } }
        },
        "responses": {
          "201": { "description": "Credit note drafted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreditNote" } } } },
          "422": { "description": "Invalid request" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreditNoteIn": {
        "type": "object",
        "required": ["customer", "amount", "reason"],
        "additionalProperties": false,
        "properties": {
          "customer": { "type": "string", "minLength": 2, "maxLength": 100 },
          "amount": { "type": "number", "exclusiveMinimum": true, "minimum": 0, "maximum": 10000 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "EUR" },
          "reason": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      },
      "CreditNote": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "customer": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "reason": { "type": "string" },
          "created_at": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
